# 复制为 .env 后按需修改；.env 不要提交到 git
# cp .env.example .env

# ---------- 数据库 ----------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/paperqa

# ---------- Embedding ----------
# 问答检索专用模型（384 维）。换成别的模型必须同步改 EMBEDDING_DIM 并重新编码全部 chunk
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1

# ---------- LLM（OpenAI 兼容接口，本项目默认用 DeepSeek）----------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace_me

# ---------- Hugging Face 模型缓存 ----------
# 模型权重默认会下到 C:\Users\<user>\.cache\huggingface，指到 E 盘避免占用 C 盘
HF_HOME=E:\conda-envs\hf-cache
