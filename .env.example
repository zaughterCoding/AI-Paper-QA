# Copy this file to .env and edit it there. Never commit .env.
#   cp .env.example .env

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/paperqa

# ---------- Embedding ----------
# QA-retrieval model, 384 dimensions. Changing it means updating EMBEDDING_DIM and
# re-encoding every chunk.
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1

# ---------- LLM (OpenAI-compatible; DeepSeek by default) ----------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace_me

# ---------- Hugging Face model cache (optional) ----------
# Model weights otherwise download to ~/.cache/huggingface. Setting HF_HOME here has no
# effect: Settings is declared with extra="ignore" and HuggingFace reads the process
# environment, so export it in your shell instead.
# HF_HOME=/path/to/hf-cache
